# ─── LOCAL DEVELOPMENT OVERRIDE ────────────────────────────────────────────
# This file overrides .env during local development (npm run dev).
# It is gitignored (*.local) — safe to store local secrets here.
#
# Switch between localhost and prod by editing just this one line:
#VITE_API_URL=http://localhost:8081

# To use the deployed Lambda instead while developing, comment the line above
# and uncomment the one below:
VITE_API_URL=https://bmo6sd3nhbgp4akoqmgoamd3ja0cmyyn.lambda-url.ap-south-1.on.aws/
